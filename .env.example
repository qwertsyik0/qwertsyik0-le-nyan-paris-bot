# Telegram bot token from BotFather. Do not commit the real token.
BOT_TOKEN=

# PostgreSQL connection string. Render Postgres usually starts with postgres://
DATABASE_URL=

# Public HTTPS base URL of this backend, for webhook and Mini App links.
# Example: https://le-nyan-paris-bot.onrender.com
PUBLIC_BASE_URL=

# Optional explicit Mini App URL. If empty, backend uses PUBLIC_BASE_URL + /miniapp/
MINI_APP_URL=

# Comma-separated Telegram IDs that can moderate applications.
ADMIN_IDS=8587776155

# Random secret for Telegram webhook header. Any long random string.
WEBHOOK_SECRET=
